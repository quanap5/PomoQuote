<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Single source of truth for the app version (SemVer); the About dialog reads it at runtime. -->
    <Version>1.3.0</Version>
    <ApplicationIcon>Assets\Logo\pomoquote.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its files out of the app. -->
    <Compile Remove="PomoQuote.Tests\**" />
    <EmbeddedResource Remove="PomoQuote.Tests\**" />
    <None Remove="PomoQuote.Tests\**" />
    <InternalsVisibleTo Include="PomoQuote.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\Wallpapers\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Mascot\*-sprites.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Mascot\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Mascot\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\Providers\*.png" LogicalName="PomoQuote.providers.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Quotes\quotes.json" LogicalName="PomoQuote.quotes.json" />
    <EmbeddedResource Include="Assets\Logo\pomoquote.ico" LogicalName="PomoQuote.pomoquote.ico" />
  </ItemGroup>

</Project>
