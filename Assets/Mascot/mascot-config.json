{
  // Default animation and behaviour settings for the taskbar character. These are also the built-in defaults.
  // To change something, do not edit this file: create %AppData%\HelloWorldBot\mascot-config.json with just the
  // fields you want to change, then press "Reload animations" in Settings > Mascot. Invalid values are ignored.
  //
  // Lengths are in device-independent pixels (96 dpi). Animation rows and frame counts must match the sprite sheet
  // (robot-sprites.png, 24x24 px cells, generated by tools/generate-mascot-sprites.ps1).

  "frameSize": 24,

  "movement": {
    "walkDipsPerSecond": 70,
    "runMultiplier": 2.2,
    "idleWalkFactor": 0.35,
    "jumpSeconds": 0.9,
    "jumpHeightDips": 30,
    "gravityDipsPerSecond2": 2600,
    "crossingSeconds": 0.8,
    "crossingArcDips": 56,
    "turnPauseSeconds": 0.25
  },

  // row = line in the sheet, frames = how many, fps = frames per second, loop = repeat while in the state
  // (otherwise it plays "loops" times and ends), loopFrom = after the first pass repeat from this frame,
  // strideDips = distance covered by one walk/run cycle (the step rate follows the speed, so feet do not slide).
  "animations": {
    "idle":      { "row": 0,  "frames": 4, "fps": 3,   "loop": true },
    "look":      { "row": 1,  "frames": 4, "fps": 5,   "loop": false },
    "walk":      { "row": 2,  "frames": 6, "fps": 10,  "loop": true, "strideDips": 40 },
    "run":       { "row": 3,  "frames": 6, "fps": 12,  "loop": true, "strideDips": 72 },
    "jump":      { "row": 4,  "frames": 6, "fps": 8,   "loop": false },
    "land":      { "row": 5,  "frames": 3, "fps": 10,  "loop": false },
    "sit":       { "row": 6,  "frames": 4, "fps": 4,   "loop": true, "loopFrom": 2 },
    "sleep":     { "row": 7,  "frames": 4, "fps": 2.5, "loop": true },
    "wave":      { "row": 8,  "frames": 6, "fps": 8,   "loop": false, "loops": 2 },
    "celebrate": { "row": 9,  "frames": 6, "fps": 8,   "loop": false, "loops": 3 },
    "surprised": { "row": 10, "frames": 4, "fps": 6,   "loop": false },
    "sad":       { "row": 11, "frames": 4, "fps": 3,   "loop": false, "loops": 2 },
    "drag":      { "row": 12, "frames": 4, "fps": 8,   "loop": true },
    "shout":     { "row": 13, "frames": 2, "fps": 6,   "loop": true }
  },

  "behavior": {
    // How long it rests between actions, how long a stroll or run lasts, how long it sits before getting up.
    "idleSeconds": { "min": 2.5, "max": 7 },
    "walkSeconds": { "min": 4, "max": 12 },
    "runSeconds": { "min": 2, "max": 6 },
    "sitSeconds": { "min": 5, "max": 12 },
    "sleepAfterSitSeconds": 6,

    // Probability weights of what it does next, per Pomodoro mood (higher = more likely; they need not add up to 100).
    // Actions: idle, look, walk, run, jump, sit, sleep, wave, celebrate, surprised, sad.
    "moods": {
      "idle":      { "walk": 40, "idle": 20, "look": 15, "sit": 10, "wave": 7, "jump": 6, "surprised": 2 },
      "working":   { "walk": 40, "run": 60 },
      "break":     { "sit": 100 },
      "longBreak": { "sleep": 100 }
    },

    // What it does when you click it.
    "reactions": { "wave": 60, "surprised": 40 }
  }
}
